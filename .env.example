# ─────────────────────────────────────────────────────────────
# Variables a nivel monorepo (NO secretos de runtime de Workers).
# Los secretos de Workers van en .dev.vars (local) y en
# `wrangler secret put` (remoto). Ver docs/env.md
# ─────────────────────────────────────────────────────────────

# Identificador del proyecto/cliente (usado en nombres de recursos)
PROJECT_SLUG=starter

# Cuenta de Cloudflare (para scripts de aprovisionamiento)
CLOUDFLARE_ACCOUNT_ID=

# Dominio del equipo de Cloudflare Access (ej: miorg.cloudflareaccess.com)
CF_ACCESS_TEAM_DOMAIN=
