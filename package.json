{
  "name": "cloudflare-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Plantilla madre Cloudflare-first para proyectos full stack pequeños y medianos.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "db:migrate:local": "pnpm --filter @infra/d1 migrate:local",
    "db:migrate:remote": "pnpm --filter @infra/d1 migrate:remote",
    "db:seed:local": "pnpm --filter @infra/d1 seed:local"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  }
}
