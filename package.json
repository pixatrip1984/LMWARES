{
  "name": "cloudflare-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Plantilla madre Cloudflare-first para proyectos full stack pequeños y medianos.",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*",
    "infra/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:local": "powershell -ExecutionPolicy Bypass -File ./scripts/local-dev.ps1",
    "setup:local": "powershell -ExecutionPolicy Bypass -File ./scripts/local-setup.ps1",
    "validate:local": "powershell -ExecutionPolicy Bypass -File ./scripts/local-validate.ps1",
    "managed:profile:new": "powershell -ExecutionPolicy Bypass -File ./scripts/new-managed-client-profile.ps1",
    "managed:profile:audit": "powershell -ExecutionPolicy Bypass -File ./scripts/managed-profile-audit.ps1",
    "managed:profile:render": "powershell -ExecutionPolicy Bypass -File ./scripts/render-managed-cloudflare-config.ps1",
    "managed:staging:doctor": "powershell -ExecutionPolicy Bypass -File ./scripts/managed-staging-doctor.ps1",
    "check:workers": "npm run check:public-api && npm run check:admin-api",
    "check:public-api": "wrangler deploy --config workers/public-api/wrangler.toml --env=\"\" --dry-run --outdir ./.wrangler/dry-run-public",
    "check:admin-api": "wrangler deploy --config workers/admin-api/wrangler.toml --env=\"\" --dry-run --outdir ./.wrangler/dry-run-admin",
    "dev:public-api": "npm run dev --workspace @workers/public-api",
    "dev:admin-api": "npm run dev --workspace @workers/admin-api",
    "dev:public-web": "npm run dev --workspace @apps/public-web",
    "dev:admin-web": "npm run dev --workspace @apps/admin-web",
    "lmwares:scan": "node scripts/scan-dev-projects.mjs",
    "lmwares:runner:doctor": "node scripts/lmwares-runner/cli.mjs doctor",
    "lmwares:runner:run": "node scripts/lmwares-runner/cli.mjs run",
    "lmwares:runner:test": "node --test scripts/lmwares-runner/*.test.mjs",
    "lmwares:agents:doctor": "node scripts/lmwares-agent-runner/cli.mjs doctor",
    "lmwares:agents:status": "node scripts/lmwares-agent-runner/cli.mjs status",
    "lmwares:agents:discover": "node scripts/lmwares-agent-runner/cli.mjs discover",
    "lmwares:agents:launch": "node scripts/lmwares-agent-runner/cli.mjs launch",
    "lmwares:agents:test": "node --test scripts/lmwares-agent-runner/*.test.mjs",
    "lmwares:free:run": "node scripts/lmwares-free-site-runner/cli.mjs",
    "lmwares:free:test": "node --test scripts/lmwares-free-site-runner/*.test.mjs",
    "lmwares:demos:run": "node scripts/lmwares-commercial-demo-runner/cli.mjs",
    "lmwares:demos:watch": "node --env-file-if-exists=scripts/lmwares-commercial-demo-runner/.env scripts/lmwares-commercial-demo-runner/daemon.mjs",
    "lmwares:demos:access": "node --env-file-if-exists=scripts/lmwares-commercial-demo-runner/.env scripts/lmwares-commercial-demo-runner/browser-access-supervisor.mjs",
    "lmwares:demos:watch": "node --env-file-if-exists=scripts/lmwares-commercial-demo-runner/.env scripts/lmwares-commercial-demo-runner/watch-demo-run.mjs",
    "lmwares:demos:install-listener": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/lmwares-commercial-demo-runner/install-at-logon.ps1 -StartNow",
    "lmwares:maintenance:validate": "pwsh -NoProfile -File ./scripts/validate-lmwares-maintenance-policy.ps1",
    "release:validate": "powershell -ExecutionPolicy Bypass -File ./scripts/lmwares-release-validate.ps1",
    "lmwares:wildcard:audit": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/configure-lmwares-free-wildcard.ps1",
    "lmwares:wildcard:apply": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/configure-lmwares-free-wildcard.ps1 -Apply",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "db:migrate:local": "npm run migrate:local --workspace @infra/d1",
    "db:migrate:remote": "npm run migrate:remote --workspace @infra/d1",
    "db:seed:local": "npm run seed:local --workspace @infra/d1",
    "db:tables:local": "npm run tables:local --workspace @infra/d1"
  },
  "devDependencies": {
    "prettier": "3.7.4",
    "puppeteer-core": "24.31.0",
    "sharp": "0.34.5",
    "turbo": "2.10.0",
    "typescript": "~5.9.3"
  }
}
