{
  "schemaVersion": 1,
  "mode": "managed-subdomain",
  "client": {
    "slug": "starter-client",
    "name": "Starter Client"
  },
  "cloudflare": {
    "accountEmail": "owner@example.com",
    "accountId": "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID",
    "zoneName": "lmwares.com",
    "zoneId": "REPLACE_WITH_LMWARES_COM_ZONE_ID",
    "accessTeamDomain": "https://REPLACE.cloudflareaccess.com",
    "accessAud": "REPLACE_WITH_ACCESS_AUD",
    "adminEmails": ["owner@example.com"]
  },
  "hostnames": {
    "public": "starter-client.lmwares.com",
    "portal": "portal-starter-client.lmwares.com",
    "publicApi": "api-starter-client.lmwares.com",
    "adminApi": "admin-api-starter-client.lmwares.com"
  },
  "resources": {
    "publicWorkerName": "starter-client-public-api",
    "adminWorkerName": "starter-client-admin-api",
    "publicPagesProject": "starter-client-public",
    "portalPagesProject": "starter-client-portal",
    "d1DatabaseName": "starter-client-db",
    "d1DatabaseId": "REPLACE_WITH_D1_DATABASE_ID",
    "r2BucketName": "starter-client-media"
  },
  "runtime": {
    "appEnv": "staging",
    "allowedOrigins": [
      "https://starter-client.lmwares.com",
      "https://portal-starter-client.lmwares.com"
    ],
    "submissionIpLimitPerHour": "60",
    "submissionContactLimitPerHour": "6"
  },
  "publicApp": {
    "turnstileSiteKey": "REPLACE_WITH_TURNSTILE_SITE_KEY"
  },
  "secrets": {
    "publicApi": ["TURNSTILE_SECRET_KEY"],
    "adminApi": []
  }
}
