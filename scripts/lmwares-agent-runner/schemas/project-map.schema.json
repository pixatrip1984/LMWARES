{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["projectName", "sections"],
  "properties": {
    "projectName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "app",
          "kind",
          "route",
          "objective",
          "criteria",
          "sourceFiles",
          "dependencies"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "app": {
            "type": "string",
            "enum": ["public-web", "admin-web"]
          },
          "kind": {
            "type": "string",
            "enum": ["page", "flow", "admin", "state"]
          },
          "route": { "type": "string", "minLength": 1, "maxLength": 180 },
          "objective": { "type": "string", "minLength": 1, "maxLength": 500 },
          "criteria": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": { "type": "string", "minLength": 1, "maxLength": 220 }
          },
          "sourceFiles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": { "type": "string", "minLength": 1, "maxLength": 260 }
          },
          "dependencies": {
            "type": "array",
            "maxItems": 12,
            "items": { "type": "string", "minLength": 1, "maxLength": 80 }
          }
        }
      }
    }
  }
}
